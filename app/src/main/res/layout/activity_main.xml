<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://android.com"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#FFFFFF"
    tools:context=".MainActivity">

    <!-- Espacio para capturar la imagen del contacto con la cámara -->
    <ImageView
        android:id="@+id/imgContacto"
        android:layout_width="130dp"
        android:layout_height="130dp"
        android:layout_gravity="center"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        android:background="#E0E0E0"
        android:src="@android:drawable/ic_menu_camera" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Seleccione el País:"
        android:textColor="#333333"
        android:textSize="14sp"
        android:layout_marginTop="8dp"/>

    <!-- Spinner para seleccionar el país (Punto extra por código de área) -->
    <Spinner
        android:id="@+id/spnPais"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:minHeight="48dp" />

    <!-- Cajas de texto con los IDs vinculados a tu MainActivity.java -->
    <EditText
        android:id="@+id/txtNombre"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nombre completo"
        android:inputType="textPersonName"
        android:minHeight="48dp"/>

    <EditText
        android:id="@+id/txtTelefono"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Teléfono"
        android:inputType="phone"
        android:minHeight="48dp"/>

    <EditText
        android:id="@+id/txtNota"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Nota o Comentario"
        android:inputType="textMultiLine"
        android:minHeight="48dp"/>

    <!-- Botón para guardar los datos en la base de datos SQLite -->
    <Button
        android:id="@+id/btnGuardar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Guardar Contacto"
        android:layout_marginTop="24dp"
        android:backgroundTint="#007BFF"
        android:textColor="#FFFFFF"/>

    <!-- Botón para ir a la lista de contactos salvados -->
    <Button
        android:id="@+id/btnVerLista"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ver Contactos Salvados"
        android:layout_marginTop="8dp"
        style="@style/Widget.MaterialComponents.Button.TextButton"/>

</LinearLayout>
