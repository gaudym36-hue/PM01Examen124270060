<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F3F4F6"
    tools:context=".ListaContactosActivity">

    <!-- Buscador dinámico de la lista (Puntos extra) -->
    <EditText
        android:id="@+id/etBuscar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Buscar contacto por nombre..."
        android:inputType="text"
        android:layout_marginBottom="10dp"
        android:padding="12dp"
        android:background="@android:drawable/edit_text"/>

    <!-- CORRECCIÓN REAL: Cambiado a ListView para que se acople perfectamente con tu código Java -->
    <ListView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="8dp"/>

</LinearLayout>
